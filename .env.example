# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role key (or the newer "secret" key, sb_secret_...). Server-only — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional but strongly recommended once deployed: a passcode that gates the whole app.
APP_PASSCODE=

# Secret the iPhone Shortcut sends to /api/sms to import bank SMS. Generate a long random value.
SMS_INGEST_TOKEN=
