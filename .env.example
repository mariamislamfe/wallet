# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key. Used to sign people in; data stays behind RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The service_role key (or the newer "secret" key, sb_secret_...). Server-only — never prefix with NEXT_PUBLIC_.
# Only /api/sms uses it, scoped to the account that owns the SMS token.
SUPABASE_SERVICE_ROLE_KEY=
